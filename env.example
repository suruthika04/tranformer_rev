# Copy to .env for local development only. Never commit .env.
GEMINI_API_KEY=PASTE_NEW_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
MONGODB_URI=mongodb+srv://DB_USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=Transformer
SECRET_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOWED_ORIGINS=https://tranformer-rev.vercel.app
USE_HF_EVAL=0
